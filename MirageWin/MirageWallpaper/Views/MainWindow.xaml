<Window
    x:Class="MirageWallpaper.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:MirageWallpaper.Models"
    Title="Mirage" Width="1160" Height="720"
    MinWidth="880" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None" AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 🌑 Catppuccin Mocha Palette -->
        <SolidColorBrush x:Key="Base" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="Mantle" Color="#181825"/>
        <SolidColorBrush x:Key="Crust" Color="#11111B"/>
        <SolidColorBrush x:Key="Surface0" Color="#313244"/>
        <SolidColorBrush x:Key="Surface1" Color="#45475A"/>
        <SolidColorBrush x:Key="Surface2" Color="#585B70"/>
        <SolidColorBrush x:Key="Overlay0" Color="#6C7086"/>
        <SolidColorBrush x:Key="Overlay1" Color="#7F849C"/>
        <SolidColorBrush x:Key="Subtext0" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="Subtext1" Color="#BAC2DE"/>
        <SolidColorBrush x:Key="Text" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="Lavender" Color="#B4BEFE"/>
        <SolidColorBrush x:Key="Blue" Color="#89B4FA"/>
        <SolidColorBrush x:Key="Sapphire" Color="#74C7EC"/>
        <SolidColorBrush x:Key="Sky" Color="#89DCEB"/>
        <SolidColorBrush x:Key="Teal" Color="#94E2D5"/>
        <SolidColorBrush x:Key="Green" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="Yellow" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="Peach" Color="#FAB387"/>
        <SolidColorBrush x:Key="Maroon" Color="#EBA0AC"/>
        <SolidColorBrush x:Key="Red" Color="#F38BA8"/>
        <SolidColorBrush x:Key="Mauve" Color="#CBA6F7"/>
        <SolidColorBrush x:Key="Pink" Color="#F5C2E7"/>
        <SolidColorBrush x:Key="Flamingo" Color="#F2CDCD"/>
        <SolidColorBrush x:Key="Rosewater" Color="#F5E0DC"/>

        <SolidColorBrush x:Key="CardBg" Color="#1C1C2E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A2A3C"/>

        <!-- Controls -->
        <Style x:Key="FluentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface0}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface1}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Subtext0}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FluentComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Surface0}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Surface1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="10,4,0,4"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Content="{TemplateBinding Content}"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="{TemplateBinding Foreground}"
                                                    Width="8" Height="5"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="10,4,20,4" VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True" Focusable="False"
                                PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                    Background="{StaticResource Surface0}"
                                    BorderBrush="{StaticResource Surface1}"
                                    BorderThickness="1" CornerRadius="8"
                                    Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="Grid" RenderOptions.ClearTypeHint="Enabled">
                                            <ItemsPresenter x:Name="ItemsPresenter"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="#4320DF"/>
            <Setter Property="BorderBrush" Value="#5535EE"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5535EE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Root grid with rounded corners -->
    <Border CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- === TITLE BAR === -->
            <Border Grid.Row="0" Background="#18000000"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="✦" FontSize="14" Foreground="{StaticResource Mauve}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Mirage" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Subtext0}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search -->
                    <Border Grid.Column="1" Width="320" HorizontalAlignment="Center"
                            Background="{StaticResource Surface0}" CornerRadius="14"
                            Height="30" BorderBrush="{StaticResource Surface1}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent"
                                Foreground="{StaticResource Text}" CaretBrush="{StaticResource Mauve}"
                                BorderThickness="0" VerticalContentAlignment="Center"
                                FontSize="12.5" Padding="32,0,12,0"
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                FontSize="12" Foreground="{StaticResource Overlay0}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                FontSize="10" Foreground="{StaticResource Overlay0}"
                                Style="{StaticResource IconButton}" Width="24" Height="24"
                                HorizontalAlignment="Right" Margin="0,0,3,0"
                                Visibility="{Binding SearchQuery, Converter={x:Static local:MainWindow.IsNotEmptyConverter}}"
                                Click="ClearSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource IconButton}"
                            ToolTip="刷新" Click="RefreshClick"/>
                        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource IconButton}"
                            ToolTip="设置" Click="SettingsClick"/>
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource IconButton}"
                            ToolTip="最小化" Click="MinimizeClick"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource IconButton}"
                            ToolTip="关闭" Click="CloseClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- === BODY === -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#0A000000"
                        BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0">
                    <StackPanel Margin="16,12">
                        <!-- Type Filter -->
                        <TextBlock Text="TYPE" FontSize="10" FontWeight="Bold"
                            Foreground="{StaticResource Overlay0}" Margin="4,0,0,6"
                            CharacterSpacing="800"/>
                        <ItemsControl ItemsSource="{Binding KindFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WallpaperKindWrapper}">
                                    <Border x:Name="KindItem" CornerRadius="6"
                                        Padding="10,7" Margin="0,1" Cursor="Hand"
                                        Background="Transparent"
                                        MouseLeftButtonDown="KindFilter_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="KindIcon" Grid.Column="0"
                                                FontSize="14" Width="20" TextAlignment="Center"
                                                Foreground="{StaticResource Overlay0}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Display}"
                                                Foreground="{StaticResource Subtext0}"
                                                FontSize="13" Margin="8,0,0,0"
                                                VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource Surface0}" Margin="0,12" Height="1"/>

                        <!-- Rating Filter -->
                        <TextBlock Text="RATING" FontSize="10" FontWeight="Bold"
                            Foreground="{StaticResource Overlay0}" Margin="4,0,0,6"
                            CharacterSpacing="800"/>
                        <ItemsControl ItemsSource="{Binding RatingFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ContentRatingWrapper}">
                                    <Border CornerRadius="6"
                                        Padding="10,7" Margin="0,1" Cursor="Hand"
                                        Background="Transparent"
                                        MouseLeftButtonDown="RatingFilter_Click">
                                        <TextBlock Text="{Binding Display}"
                                            Foreground="{StaticResource Subtext0}"
                                            FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource Surface0}" Margin="0,12" Height="1"/>

                        <!-- Sort -->
                        <TextBlock Text="SORT" FontSize="10" FontWeight="Bold"
                            Foreground="{StaticResource Overlay0}" Margin="4,0,0,6"
                            CharacterSpacing="800"/>
                        <ComboBox Style="{StaticResource FluentComboBox}"
                            ItemsSource="{Binding SortOptions}"
                            SelectedValue="{Binding SortMode}"
                            SelectedValuePath="Value" DisplayMemberPath="Display"/>

                        <Separator Background="{StaticResource Surface0}" Margin="0,12" Height="1"/>

                        <Button Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource FluentButton}" Margin="0,4,0,0"/>

                        <TextBlock Text="{Binding FilteredWallpapers.Count, StringFormat='{}{0} wallpapers'}"
                            Foreground="{StaticResource Overlay0}" FontSize="11"
                            Margin="4,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Wallpaper Grid -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16">
                            <!-- Info header -->
                            <TextBlock x:Name="SectionTitle" Text="All Wallpapers"
                                FontSize="15" FontWeight="SemiBold"
                                Foreground="{StaticResource Subtext0}"
                                Margin="4,0,0,12"/>

                            <!-- Wallpaper cards -->
                            <ItemsControl ItemsSource="{Binding FilteredWallpapers}"
                                x:Name="WallpaperList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:WallpaperModel}">
                                        <Border Width="220" Height="170" Margin="0,0,14,14"
                                            CornerRadius="10" Cursor="Hand"
                                            Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1"
                                            MouseLeftButtonDown="WallpaperCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#252540"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Surface2}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Preview area -->
                                                <Border Grid.Row="0" CornerRadius="10,10,0,0"
                                                    Background="{StaticResource Crust}">
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                            <TextBlock x:Name="KindEmoji" FontSize="28"
                                                                TextAlignment="Center"/>
                                                            <TextBlock Text="{Binding KindDisplay}"
                                                                FontSize="11" TextAlignment="Center"
                                                                Foreground="{StaticResource Overlay0}"
                                                                Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Title & author -->
                                                <Border Grid.Row="1" CornerRadius="0,0,10,10"
                                                    Padding="12,9"
                                                    Background="{StaticResource Mantle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                            Text="{Binding Title}"
                                                            FontSize="12" FontWeight="SemiBold"
                                                            Foreground="{StaticResource Text}"
                                                            TextTrimming="CharacterEllipsis"
                                                            MaxHeight="32"/>
                                                        <StackPanel Grid.Row="1"
                                                            Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock FontSize="10"
                                                                Foreground="{StaticResource Overlay0}">
                                                                <Run Text="{Binding Author, TargetNullValue='Unknown'}"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="10"
                                                                Foreground="{StaticResource Surface2}"
                                                                Margin="6,0,0,0">
                                                                <Run Text="{Binding SourceDisplay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2"
                                                            Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border CornerRadius="3"
                                                                Padding="4,1"
                                                                Background="{StaticResource Surface0}">
                                                                <TextBlock FontSize="9"
                                                                    Foreground="{StaticResource Overlay0}"
                                                                    Text="{Binding RatingDisplay}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Playback Bar -->
                    <Border Grid.Row="1"
                        Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="0,1,0,0">
                        <Grid Height="44" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Now Playing -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="4"
                                    Background="{StaticResource Surface0}" Margin="0,0,8,0">
                                    <TextBlock x:Name="NowPlayingKind" FontSize="11"
                                        TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="NowPlayingText" Text="No wallpaper active"
                                    FontSize="12" Foreground="{StaticResource Subtext0}"
                                    VerticalAlignment="Center" MaxWidth="300"
                                    TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Playback Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="&#xE74F;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="12"
                                    Command="{Binding DecrementVolumeCommand}"/>
                                <Slider Width="80" Minimum="0" Maximum="1"
                                    Value="{Binding PlayVolume}"
                                    VerticalAlignment="Center" Margin="2,0"
                                    Background="Transparent"/>
                                <Button Content="&#xE995;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="12"
                                    Command="{Binding IncrementVolumeCommand}"/>
                                <Button Content="&#xE74F;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="14"
                                    Command="{Binding ToggleMuteCommand}"/>
                                <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                    x:Name="PlayPauseBtn"
                                    Style="{StaticResource IconButton}" Width="40" Height="40" FontSize="16"
                                    Command="{Binding TogglePauseCommand}"/>
                            </StackPanel>

                            <!-- Info -->
                            <TextBlock Grid.Column="2" x:Name="DebugInfo" FontSize="11"
                                Foreground="{StaticResource Overlay0}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
